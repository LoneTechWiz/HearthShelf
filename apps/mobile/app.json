{
  "expo": {
    "name": "HearthShelf",
    "slug": "hearthshelf",
    "scheme": "hearthshelf",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HearthShelf to scan ISBN barcodes."
        }
      ],
      "expo-notifications"
    ],
    "ios": {
      "bundleIdentifier": "com.lonetechwiz.hearthshelf",
      "buildNumber": "1"
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.lonetechwiz.hearthshelf"
    }
  }
}
